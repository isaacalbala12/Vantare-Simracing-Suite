<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 rescap">
  <!-- Identidad solo local. Sustituir por los valores exactos de Partner Center. -->
  <Identity Name="Vantare.Native.LocalTest" Publisher="CN=Vantare Native Local Test" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Vantare Native Candidate</DisplayName>
    <PublisherDisplayName>Vantare (prueba local)</PublisherDisplayName>
    <Description>Candidato nativo de prueba, ADR 0099</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources><Resource Language="es-ES" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="Hub" Executable="bin\vantare-hub.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="Vantare Native Candidate" Description="Hub nativo de prueba" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent" />
    </Application>
    <!-- Activación con argumentos para replay/live y Engineer; no otro launcher. -->
    <Application Id="Runtime" Executable="bin\vantare.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="Vantare Native Runtime" Description="Supervisor nativo de prueba" AppListEntry="none" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent" />
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
</Package>
