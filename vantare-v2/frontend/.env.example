# Supabase (required for auth + billing Edge Functions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Clerk (publishable key for the embedded sign-in)
VITE_CLERK_PUBLISHABLE_KEY=

# Billing (Polar sandbox). Keep false until sandbox smoke is approved.
VITE_BILLING_ENABLED=false