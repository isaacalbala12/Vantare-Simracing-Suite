{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testing-center.codex-fix-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestDigest",
    "analysisBaseSha",
    "status",
    "summary",
    "rootCauseHypothesis",
    "files",
    "tests",
    "riskNotes",
    "humanReviewChecklist"
  ],
  "properties": {
    "contractVersion": {
      "const": "testing-center.codex-fix-output.v1"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "analysisBaseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": ["proposed", "needs_owner", "not_reproduced"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "rootCauseHypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "files": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "changeKind", "content", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "changeKind": { "enum": ["create", "replace"] },
          "content": { "type": "string", "maxLength": 16000 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "reason"],
        "properties": {
          "commandId": {
            "enum": [
              "frontend.test.focal",
              "frontend.test.global",
              "frontend.build",
              "frontend.lint.focal"
            ]
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "riskNotes": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "humanReviewChecklist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "proposed" } } },
      "then": {
        "properties": {
          "files": { "minItems": 1 },
          "tests": { "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "files": { "maxItems": 0 },
          "tests": { "maxItems": 0 }
        }
      }
    }
  ]
}
