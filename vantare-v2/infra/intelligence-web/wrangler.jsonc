{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vantare-intelligence-private",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
