{
  "name": "@vantare/hub-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "build": "electron-vite build",
    "typecheck": "bun run contract:index && tsc --noEmit",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "lint": "biome check . && bun run lint:design",
    "test": "vitest run",
    "package": "bun scripts/package.ts",
    "smoke": "bun scripts/smoke.ts",
    "tokens": "bun scripts/tokens.ts",
    "fonts": "bun scripts/fonts.ts",
    "icons": "bun scripts/icons.ts",
    "lint:design": "bun scripts/lint-design.ts",
    "lint:i18n": "bun scripts/lint-design.ts",
    "contract:index": "bun scripts/contract-index.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "8.1.0",
    "@biomejs/biome": "2.6.6",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.0",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.65.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "trustedDependencies": [
    "electron"
  ]
}
