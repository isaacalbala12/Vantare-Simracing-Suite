      "factEvent": "telemetry:strategy:fact",
      "projectionRoute": "/telemetry/strategy/projection",
      "factsRoute": "/telemetry/strategy/facts"
    },
    "analysis": {
      "projectionEvent": "telemetry:analysis:projection",
