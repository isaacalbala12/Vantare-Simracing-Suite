{
  "version": 1,
  "modules": [
    "vantare.module.analysis",
    "vantare.module.calendar",
    "vantare.module.engineer",
    "vantare.module.strategy"
  ],
  "statuses": [
    "draft",
    "submitted",
    "validated",
    "duplicate_linked",
    "incomplete",
    "closed",
    "in_review",
    "rejected",
    "fixed",
    "spam"
  ],
  "actions": {
    "search_accounts": {
      "mutation": false,
      "explicit_payments": false,
      "fields": [
        "query",
        "limit",
        "cursor"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "query": "",
        "limit": 50,
        "cursor": "19106900-0000-4000-8000-000000000001"
      }
    },
    "get_account": {
      "mutation": false,
      "explicit_payments": true,
      "fields": [
        "account_id"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "account_id": "19106900-0000-4000-8000-000000000001"
      }
    },
    "set_blocked": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "account_id",
        "blocked",
        "reason"
      ],
      "mail": false,
      "environment": "sandbox",
      "example": {
        "account_id": "19106900-0000-4000-8000-000000000001",
        "blocked": true,
        "reason": "fixture"
      }
    },
    "delete_account": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "account_id",
        "confirm_email"
      ],
      "mail": false,
      "environment": "sandbox",
      "example": {
        "account_id": "19106900-0000-4000-8000-000000000001",
        "confirm_email": "fixture@example.invalid"
      }
    },
    "set_tester": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "account_id",
        "enabled"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "account_id": "19106900-0000-4000-8000-000000000001",
        "enabled": true
      }
    },
    "set_module": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "account_id",
        "module",
        "enabled",
        "expected_enabled"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "account_id": "19106900-0000-4000-8000-000000000001",
        "module": "vantare.module.analysis",
        "enabled": true,
        "expected_enabled": false
      }
    },
    "sync_payments": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [],
      "mail": false,
      "environment": "sandbox",
      "example": {}
    },
    "list_creators": {
      "mutation": false,
      "explicit_payments": true,
      "fields": [],
      "mail": false,
      "environment": "both",
      "example": {}
    },
    "get_creator": {
      "mutation": false,
      "explicit_payments": true,
      "fields": [
        "creator_id"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "creator_id": "19106900-0000-4000-8000-000000000001"
      }
    },
    "record_creator_payout": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "creator_id",
        "amount_cents",
        "paid_at"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "creator_id": "19106900-0000-4000-8000-000000000001",
        "amount_cents": 100,
        "paid_at": "2026-11-04T00:00:00Z"
      }
    },
    "create_creator": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "name",
        "email",
        "code"
      ],
      "mail": false,
      "environment": "sandbox",
      "example": {
        "name": "fixture",
        "email": "fixture@example.invalid",
        "code": "CREATOR"
      }
    },
    "get_rollout": {
      "mutation": false,
      "explicit_payments": false,
      "fields": [],
      "mail": false,
      "environment": "both",
      "example": {}
    },
    "set_rollout": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "module",
        "enabled_for_all",
        "expected_enabled"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "module": "vantare.module.analysis",
        "enabled_for_all": true,
        "expected_enabled": false
      }
    },
    "list_reports": {
      "mutation": false,
      "explicit_payments": false,
      "fields": [
        "status",
        "limit",
        "cursor"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "status": "submitted",
        "limit": 50,
        "cursor": "19106900-0000-4000-8000-000000000001"
      }
    },
    "get_report": {
      "mutation": false,
      "explicit_payments": false,
      "fields": [
        "report_id"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "report_id": "19106900-0000-4000-8000-000000000001"
      }
    },
    "set_report_status": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "report_id",
        "status",
        "fixed_in_version",
        "reason"
      ],
      "mail": false,
      "environment": "both",
      "example": {
        "report_id": "19106900-0000-4000-8000-000000000001",
        "status": "submitted",
        "fixed_in_version": "1.2.3",
        "reason": "fixture"
      }
    },
    "mail_forget_waitlist": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "email",
        "confirm"
      ],
      "mail": true,
      "environment": "both",
      "example": {
        "email": "fixture@example.invalid",
        "confirm": true
      }
    },
    "mail_cleanup": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [],
      "mail": true,
      "environment": "both",
      "example": {}
    },
    "mail_list": {
      "mutation": false,
      "explicit_payments": false,
      "fields": [],
      "mail": true,
      "environment": "both",
      "example": {}
    },
    "mail_new": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [],
      "mail": true,
      "environment": "both",
      "example": {}
    },
    "mail_get": {
      "mutation": false,
      "explicit_payments": false,
      "fields": [
        "campaign_id"
      ],
      "mail": true,
      "environment": "both",
      "example": {
        "campaign_id": "19106900-0000-4000-8000-000000000001"
      }
    },
    "mail_save": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "campaign_id",
        "revision",
        "name",
        "template",
        "target_group",
        "content"
      ],
      "mail": true,
      "environment": "both",
      "example": {
        "campaign_id": "19106900-0000-4000-8000-000000000001",
        "revision": 1,
        "name": "fixture",
        "template": "news",
        "target_group": "free",
        "content": {
          "es": {
            "subject": "fixture",
            "body": "fixture"
          },
          "en": {
            "subject": "fixture",
            "body": "fixture"
          },
          "it": {
            "subject": "fixture",
            "body": "fixture"
          },
          "pt-BR": {
            "subject": "fixture",
            "body": "fixture"
          }
        }
      }
    },
    "mail_approve": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "campaign_id",
        "revision",
        "confirm",
        "expected_recipients"
      ],
      "mail": true,
      "environment": "both",
      "example": {
        "campaign_id": "19106900-0000-4000-8000-000000000001",
        "revision": 1,
        "confirm": true,
        "expected_recipients": 0
      }
    },
    "mail_cancel": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "campaign_id",
        "revision"
      ],
      "mail": true,
      "environment": "both",
      "example": {
        "campaign_id": "19106900-0000-4000-8000-000000000001",
        "revision": 1
      }
    },
    "mail_send_batch": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "campaign_id",
        "revision"
      ],
      "mail": true,
      "environment": "both",
      "example": {
        "campaign_id": "19106900-0000-4000-8000-000000000001",
        "revision": 1
      }
    },
    "mail_draft": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "campaign_id",
        "revision",
        "brief",
        "template"
      ],
      "mail": true,
      "environment": "both",
      "example": {
        "campaign_id": "19106900-0000-4000-8000-000000000001",
        "revision": 1,
        "brief": "fixture",
        "template": "news"
      }
    },
    "mail_sync": {
      "mutation": true,
      "explicit_payments": false,
      "fields": [
        "cursor"
      ],
      "mail": true,
      "environment": "both",
      "example": {
        "cursor": "19106900-0000-4000-8000-000000000001"
      }
    }
  }
}
