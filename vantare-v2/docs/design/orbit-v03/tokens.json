{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Vantare · Command Orbit v0.3 design tokens. Fuente: docs/design/orbit-v03/02-tokens.md",
  "color": {
    "canvas": { "$type": "color", "$value": "#08090b" },
    "surface": {
      "0": { "$type": "color", "$value": "#0d0e11" },
      "1": { "$type": "color", "$value": "#121316" },
      "2": { "$type": "color", "$value": "#18191e" },
      "3": { "$type": "color", "$value": "#202127" },
      "rail": { "$type": "color", "$value": "#0b0c0e" },
      "column": { "$type": "color", "$value": "#0f1013" },
      "panel": { "$type": "color", "$value": "rgba(16,17,20,0.79)", "$description": "con backdrop-filter blur 16px" },
      "topbar": { "$type": "color", "$value": "rgba(8,9,11,0.82)" }
    },
    "ink": {
      "1": { "$type": "color", "$value": "#f5f3f2" },
      "2": { "$type": "color", "$value": "#b7b2b2" },
      "3": { "$type": "color", "$value": "#8a858b" },
      "4": { "$type": "color", "$value": "#787379" },
      "muted": { "$type": "color", "$value": "#57545a" }
    },
    "line": {
      "default": { "$type": "color", "$value": "rgba(255,255,255,0.075)" },
      "strong": { "$type": "color", "$value": "rgba(255,255,255,0.13)" },
      "row": { "$type": "color", "$value": "rgba(255,255,255,0.045)" }
    },
    "accent": {
      "carmine": { "$type": "color", "$value": "#d52f49" },
      "red": { "$type": "color", "$value": "#f04755" },
      "coral": { "$type": "color", "$value": "#ff6a5f" },
      "ember": { "$type": "color", "$value": "#ff9b57" },
      "wine": { "$type": "color", "$value": "#641526" }
    },
    "semantic": {
      "ok": { "$type": "color", "$value": "#78d68b" },
      "warn": { "$type": "color", "$value": "#ff9b57" },
      "danger": { "$type": "color", "$value": "#f04755" },
      "reference": { "$type": "color", "$value": "#5ccbd5" },
      "reference-soft": { "$type": "color", "$value": "#8fd6dd" }
    },
    "tier": {
      "bronze": { "$type": "color", "$value": "#d29a6c" },
      "silver": { "$type": "color", "$value": "#c9c9cf" },
      "gold": { "$type": "color", "$value": "#ff9b57" }
    },
    "tyre": {
      "soft": { "$type": "color", "$value": "#ff8b8b" },
      "medium": { "$type": "color", "$value": "#ffd166" },
      "hard": { "$type": "color", "$value": "#e6e2e2" }
    },
    "primary": {
      "bg": { "$type": "color", "$value": "#f3eeee" },
      "ink": { "$type": "color", "$value": "#1c1719" }
    }
  },
  "gradient": {
    "brand": { "$type": "gradient", "$value": "linear-gradient(145deg, {color.accent.coral}, {color.accent.carmine} 62%, {color.accent.wine})" },
    "featured-border": { "$type": "gradient", "$value": "linear-gradient(115deg, rgba(240,71,85,0.62), rgba(255,106,95,0.2), rgba(255,255,255,0.06))" },
    "featured-fill": { "$type": "gradient", "$value": "linear-gradient(rgba(25,25,30,0.98), rgba(19,19,23,0.99))" },
    "selection": { "$type": "gradient", "$value": "linear-gradient(90deg, rgba(213,47,73,0.11), rgba(213,47,73,0.02))" }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "Segoe UI Variable", "Segoe UI", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["Cascadia Code", "SFMono-Regular", "ui-monospace", "monospace"] }
    },
    "size": {
      "base": { "$type": "dimension", "$value": "16px" },
      "greet": { "$type": "dimension", "$value": "39px" },
      "page": { "$type": "dimension", "$value": "34px" },
      "focal": { "$type": "dimension", "$value": "28px" },
      "event": { "$type": "dimension", "$value": "26px" },
      "kpi": { "$type": "dimension", "$value": "22px" },
      "sect": { "$type": "dimension", "$value": "20px" },
      "panel": { "$type": "dimension", "$value": "15px" },
      "body": { "$type": "dimension", "$value": "13.5px" },
      "secondary": { "$type": "dimension", "$value": "12px" },
      "eyebrow": { "$type": "dimension", "$value": "12px" },
      "micro": { "$type": "dimension", "$value": "10.5px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 560 },
      "semibold": { "$type": "fontWeight", "$value": 650 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "heavy": { "$type": "fontWeight", "$value": 800 },
      "black": { "$type": "fontWeight", "$value": 850 }
    },
    "tracking": {
      "tight-lg": { "$type": "dimension", "$value": "-0.045em" },
      "tight": { "$type": "dimension", "$value": "-0.03em" },
      "panel": { "$type": "dimension", "$value": "-0.01em" },
      "eyebrow": { "$type": "dimension", "$value": "0.15em" },
      "micro": { "$type": "dimension", "$value": "0.08em" }
    }
  },
  "size": {
    "row": { "$type": "dimension", "$value": "49px", "$extensions": { "vantare.density": { "compact": "42px", "comfortable": "57px" } } },
    "space": { "$type": "dimension", "$value": "21px", "$extensions": { "vantare.density": { "compact": "16px", "comfortable": "26px" } } },
    "radius": { "$type": "dimension", "$value": "18px", "$extensions": { "vantare.density": { "compact": "14px", "comfortable": "22px" } } },
    "radius-featured": { "$type": "dimension", "$value": "25px" },
    "radius-control": { "$type": "dimension", "$value": "12px" },
    "radius-chip": { "$type": "dimension", "$value": "8px" },
    "rail-width": { "$type": "dimension", "$value": "81px" },
    "column-width": { "$type": "dimension", "$value": "296px" },
    "inspector-width": { "$type": "dimension", "$value": "395px" },
    "topbar-height": { "$type": "dimension", "$value": "70px" },
    "control-height": { "$type": "dimension", "$value": "39px" },
    "control-height-sm": { "$type": "dimension", "$value": "34px" },
    "content-max": { "$type": "dimension", "$value": "1508px" },
    "min-viewport-width": { "$type": "dimension", "$value": "1180px" }
  },
  "shadow": {
    "featured": { "$type": "shadow", "$value": "0 32px 91px rgba(0,0,0,0.42), 0 0 42px rgba(213,47,73,0.04)" },
    "primary": { "$type": "shadow", "$value": "0 13px 34px rgba(0,0,0,0.35)" },
    "toast": { "$type": "shadow", "$value": "0 23px 78px rgba(0,0,0,0.5)" },
    "palette": { "$type": "shadow", "$value": "0 44px 143px rgba(0,0,0,0.66), 0 0 58px rgba(213,47,73,0.05)" },
    "menu": { "$type": "shadow", "$value": "0 24px 70px rgba(0,0,0,0.6)" },
    "glow-active": { "$type": "shadow", "$value": "0 0 13px rgba(240,71,85,0.6)" }
  },
  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
    "ease-spring": { "$type": "cubicBezier", "$value": [0.34, 1.4, 0.64, 1] },
    "fast": { "$type": "duration", "$value": "130ms" },
    "med": { "$type": "duration", "$value": "200ms" },
    "enter": { "$type": "duration", "$value": "300ms" },
    "move": { "$type": "duration", "$value": "350ms" },
    "stagger": { "$type": "duration", "$value": "40ms" }
  },
  "z": {
    "rail": { "$type": "number", "$value": 20 },
    "topbar": { "$type": "number", "$value": 15 },
    "menu": { "$type": "number", "$value": 30 },
    "tooltip": { "$type": "number", "$value": 40 },
    "palette": { "$type": "number", "$value": 100 },
    "toast": { "$type": "number", "$value": 120 }
  }
}
