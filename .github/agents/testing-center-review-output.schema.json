{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testing-center-review/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "verdict",
    "headSha",
    "headDigest",
    "criteria",
    "findings",
    "testQuality",
    "scope"
  ],
  "properties": {
    "contractVersion": {
      "const": "testing-center-review/v1"
    },
    "verdict": {
      "type": "string",
      "enum": ["approve", "reject", "needs_owner"]
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "headDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "note"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "unknown"]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 500 }
        },
        "P1": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 500 }
        },
        "P2": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 500 }
        },
        "P3": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "testQuality": {
      "type": "string",
      "enum": ["pass", "fail", "unknown"]
    },
    "scope": {
      "type": "string",
      "enum": ["pass", "fail", "unknown"]
    }
  }
}
